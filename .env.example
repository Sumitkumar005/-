# --- Supabase (required) -------------------------------------------------
# Project Settings > API in your Supabase dashboard (free plan is fine).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM: Groq (optional, free tier) -------------------------------------
# Get a key at https://console.groq.com/keys. Leave empty to run in offline mock mode.
GROQ_API_KEY=
# Defaults shown. gpt-oss models support strict JSON schema output on Groq.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# Requests per minute we allow ourselves (free tier is about 30).
GROQ_RPM=28
# LLM_PROVIDER=mock   # force offline mode even with a key

# --- Voice ----------------------------------------------------------------
# "simulated" (default): no real calls; suppliers are simulated from demo profiles.
# "bolna": real outbound calls via Bolna (Indian numbers, Hinglish voices). Read docs/07 first.
VOICE_PROVIDER=simulated
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
# Webhook URL to configure in Bolna: <APP_URL>/api/webhooks/voice/bolna?secret=<this>
VOICE_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Delay per simulated call so the demo feels live (ms).
SIM_CALL_DELAY_MS=1200
# Enforce Mon-Sat 10:00-18:30 IST even in simulation.
SIMULATION_RESPECT_HOURS=false
MAX_CALL_ATTEMPTS=2

# --- Optional sources -----------------------------------------------------
# Google Places API (New) key to discover suppliers near the buyer.
GOOGLE_PLACES_API_KEY=
# Your GST data provider adapter (GSP). See src/lib/pipeline/gst-provider.ts.
GST_LOOKUP_URL=
GST_LOOKUP_KEY=

# --- Ops ------------------------------------------------------------------
# Hold every shortlist for a human check before the buyer sees it.
OPS_REVIEW_SHORTLIST=false
WORKER_CONCURRENCY=2
